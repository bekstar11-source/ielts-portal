rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    /**
     * Anonim (guest) sessiya.
     *
     * Landing page'dagi bepul trial `signInAnonymously()` bilan ishlaydi —
     * ya'ni SAYTGA KIRGAN HAR QANDAY ODAM `request.auth != null` bo'lib qoladi.
     */
    function isAnonymous() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    /**
     * Ro'yxatdan o'tgan (haqiqiy) foydalanuvchi.
     *
     * ⚠️ DIQQAT: bu yerda ataylab `request.auth != null` DEYILMAGAN.
     * Anonim kirish yoqilgandan keyin oddiy `!= null` tekshiruvi butun
     * bazani ochib yuborardi: istalgan tashrifchi bir soniyada anonim token
     * olib, `podcasts`, `articles`, `tests_metadata`, `announcements` va
     * qolgan hamma `isAuth()` bilan himoyalangan kolleksiyani o'qiy olardi.
     *
     * Guest'ga to'g'ridan-to'g'ri Firestore kerak EMAS: trial butunlay
     * Cloud Functions orqali ishlaydi (`getTrialTest`, `submitTrial`), ular
     * esa Admin SDK bilan qoidalardan chetlab o'tadi. Shuning uchun eng
     * xavfsiz yechim — anonim sessiyaga bu yerda umuman ruxsat bermaslik.
     */
    function isAuth() {
      return request.auth != null && !isAnonymous();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && getUserData().get('role', 'none') == 'admin';
    }

    function isTeacher() {
      return isAuth() && getUserData().get('role', 'student') == 'teacher';
    }

    // ─── Ijtimoiy hisoblagichlar uchun umumiy yordamchilar ──────────────
    //
    // ⚠️ `affectedKeys().hasOnly([...])` faqat QAYSI maydon tegilganini
    // tekshiradi, u QANDAY o'zgarganini emas. Ya'ni "faqat `claps` ni
    // o'zgartirishga ruxsat" degani "claps ni 999999 qilib qo'yishga ham
    // ruxsat" degani edi. Quyidagilar o'zgarish MIQDORINI cheklaydi.

    /** Hisoblagich faqat bittaga oshishi yoki kamayishi mumkin. */
    function counterDeltaOk(field) {
      return request.resource.data.get(field, 0) is int
             && request.resource.data.get(field, 0) >= resource.data.get(field, 0) - 1
             && request.resource.data.get(field, 0) <= resource.data.get(field, 0) + 1;
    }

    /** Ro'yxat uzunligi ko'pi bilan bitta element o'zgargan bo'lsin. */
    function listDeltaOk(field) {
      return request.resource.data.get(field, []).size() >= resource.data.get(field, []).size() - 1
             && request.resource.data.get(field, []).size() <= resource.data.get(field, []).size() + 1;
    }

    /** `likes` massivida faqat O'Z uid'ini qo'shish/olib tashlash mumkin. */
    function likesTouchSelfOnly() {
      return resource.data.get('likes', []).toSet().difference([request.auth.uid].toSet())
             == request.resource.data.get('likes', []).toSet().difference([request.auth.uid].toSet());
    }

    // --- COLLECTION RULES ---

    // USERS
    match /users/{userId} {
      // ⚠️ Obuna, rol va topshiriq maydonlari KLIENTDAN yozilmasligi shart.
      // Ilgari egasiga to'liq `write` berilgan edi — ya'ni istalgan o'quvchi
      // konsoldan `accountType: 'pro'` yozib butun to'lov tizimini chetlab
      // o'ta olardi. Bu maydonlar faqat Admin SDK (Telegram bot / Cloud
      // Functions) yoki admin tomonidan o'zgartiriladi.
      function protectedUserFields() {
        return [
          'role', 'accountType', 'isPro', 'isPremium', 'isStandard', 'tier',
          'subscriptionStart', 'subscriptionEnd', 'teacherSubscription',
          'assignedTests', 'mockTests', 'groupId', 'signupDiscount'
        ];
      }

      function touchesProtectedFields() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(protectedUserFields());
      }

      allow read: if isAuth() && (request.auth.uid == userId || isAdmin() || isTeacher());

      // Ro'yxatdan o'tish: faqat o'zining hujjati, bepul tarif bilan.
      allow create: if isAuth()
                    && request.auth.uid == userId
                    && request.resource.data.get('accountType', 'public') == 'public'
                    && request.resource.data.get('role', 'student') == 'student'
                    && !request.resource.data.keys().hasAny(
                         ['isPro', 'isPremium', 'isStandard', 'tier',
                          'subscriptionStart', 'subscriptionEnd', 'teacherSubscription']
                       );

      allow update: if isAdmin()
                    || (isAuth() && request.auth.uid == userId && !touchesProtectedFields());

      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }

    // TESTS
    match /tests/{testId} {
      // Raw test documents contain answer keys — only staff may list/query them.
      // Students browse via /tests_metadata (answer-free) and fetch sanitized
      // content through the getSanitizedTest Cloud Function.
      allow list: if isAdmin() || isTeacher();

      // Secure direct reads of raw test documents containing answers
      allow get: if isAuth() && (
        isAdmin() || 
        isTeacher() || 
        exists(/databases/$(database)/documents/results/$(request.auth.uid + '_' + testId)) ||
        exists(/databases/$(database)/documents/results/$(request.auth.uid + '_' + testId + '_part_1')) ||
        exists(/databases/$(database)/documents/results/$(request.auth.uid + '_' + testId + '_part_2')) ||
        exists(/databases/$(database)/documents/results/$(request.auth.uid + '_' + testId + '_part_3')) ||
        exists(/databases/$(database)/documents/results/$(request.auth.uid + '_' + testId + '_part_4'))
      );
      
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // TESTS METADATA
    match /tests_metadata/{metaId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isTeacher();
    }

    // ANNOUNCEMENTS
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // BOSH SAHIFA SPOTLIGHT (aksiyalar + savol parchalari)
    // Faqat reklama kontenti — bu yerdagi `answer` haqiqiy test kalitiga
    // tegishli emas, ataylab ochiq ko'rsatiladi. Yozish — faqat admin.
    match /promo_spotlights/{spotlightId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // RESULTS
    // ⚠️ Test natijalari SERVERDA yoziladi (submitTestAnswers / submitMockExam —
    // Admin SDK bu qoidalarni chetlab o'tadi). Klientga yozish huquqi berilishi
    // ikki xil hujumga yo'l ochadi, shuning uchun quyida qattiq cheklangan.
    match /results/{resultId} {
      // `{uid}_{testId}` ko'rinishidagi ID — yuqoridagi `tests` qoidasi uchun
      // "topshirdim" kvitansiyasi. Klient bunday ID li hujjat YARATA OLMASLIGI shart:
      // aks holda istalgan test uchun soxta kvitansiya yozib, o'sha testning
      // javob kalitlarini to'g'ridan-to'g'ri o'qib olardi (getSanitizedTest chetlab o'tilardi).
      function isReceiptId() {
        return resultId.matches('^' + request.auth.uid + '_.*');
      }

      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resultId.matches('^' + request.auth.uid + '.*') ||
        isAdmin() ||
        isTeacher()
      );

      // Klientda faqat avto-ID li hujjatlar yaratiladi (diagnostika). Test topshirish
      // Cloud Function orqali ketadi va bu qoidaga bo'ysunmaydi.
      allow create: if isAuth()
                    && request.resource.data.userId == request.auth.uid
                    && !isReceiptId();

      // Ball qo'yish — faqat o'qituvchi/admin ishi. Ilgari egasiga ham ruxsat berilgan edi,
      // ya'ni talaba o'z `bandScore` / `scores` / `status` maydonlarini 9.0 ga o'zgartira olardi.
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // GROUPS
    match /groups/{groupId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isTeacher();
    }
    
    // TEST SETS
    match /testSets/{setId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }

    // TEST COLLECTIONS
    match /test_collections/{collectionId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // PODCAST COLLECTIONS
    match /podcast_collections/{collectionId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ARTICLES
    // Izohlar butun massiv sifatida qayta yoziladi (ArticleReading.jsx), shuning
    // uchun "o'z izohini o'chirish" bilan "hamma izohni o'chirish" ni qoida
    // darajasida ajratib bo'lmaydi — lekin bir marta chaqiruvda ko'pi bilan
    // BITTA izoh o'zgarishini talab qilib, ommaviy o'chirishni to'sib qo'yamiz.
    match /articles/{articleId} {
      allow read: if isAuth();
      allow update: if isAdmin() || isTeacher() || (
        isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claps', 'comments'])
        && counterDeltaOk('claps')
        && listDeltaOk('comments')
      );
      allow create, delete: if isAdmin() || isTeacher();
    }

    // LOGS
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth(); // Secured: only authenticated users can log
      allow update, delete: if isAdmin();
    }
    
    // ACCESS KEYS
    match /accessKeys/{keyId} {
      allow read: if isAuth() && (isAdmin() || isTeacher());
      allow write: if isAdmin();
    }

    // PODCASTS
    match /podcasts/{podcastId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      // `likesCount` — PodcastContext `increment(±1)` yuboradi, shuning uchun
      // qadam ham ±1 bilan cheklanadi (ilgari istalgan son yozib bo'lardi).
      allow update: if isAdmin() || (
        isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
        && counterDeltaOk('likesCount')
      );

      match /{allSub=**} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // PODCAST ATTEMPTS
    match /podcastAttempts/{attemptId} {
      allow read: if isAuth() && (resource == null || resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      // Egalik tekshiruvi: ilgari `create: if isAuth()` edi, ya'ni boshqa
      // o'quvchi nomidan urinish yozib qo'yish mumkin edi.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // PODCAST RESULTS
    match /podcastResults/{resultId} {
      allow read: if isAuth() && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isAdmin() || 
        isTeacher()
      );
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // PODCAST LIKES — har bir foydalanuvchi faqat o'z like'larini ko'radi va boshqaradi.
    // Qoida yo'q edi, ya'ni default deny: PodcastContext dagi onSnapshot har safar
    // "Missing or insufficient permissions" bilan yiqilardi.
    match /podcastLikes/{likeId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // TEST COMMENTS
    // Egalik tekshiruvi qo'shildi: ilgari `create: if isAuth()` edi, ya'ni
    // istalgan odam `userId`/`userName`/`userRole` ni boshqa kishinikiga
    // qo'yib, uning nomidan izoh yoki shikoyat yozib qo'ya olardi.
    match /testComments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.get('userRole', 'student') == getUserData().get('role', 'student');
      allow update: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // STORIES
    // Ovoz berish `interactiveData.votes.{idx}` ni oshiradi. Ammo ichma-ich
    // yozuvda ham `affectedKeys()` faqat `interactiveData` ni ko'radi — ya'ni
    // eski qoida o'quvchiga BUTUN `interactiveData` ni (savol, variantlar,
    // to'g'ri javob indeksi) qayta yozish imkonini berardi. Endi savol
    // tarkibi o'zgarmasligi va variantlar o'chib ketmasligi talab qilinadi.
    function storyContentUnchanged() {
      return request.resource.data.interactiveData.get('type', '') == resource.data.interactiveData.get('type', '')
             && request.resource.data.interactiveData.get('question', '') == resource.data.interactiveData.get('question', '')
             && request.resource.data.interactiveData.get('options', []) == resource.data.interactiveData.get('options', [])
             && request.resource.data.interactiveData.get('correctIndex', -1) == resource.data.interactiveData.get('correctIndex', -1)
             && request.resource.data.interactiveData.get('votes', {}).keys().hasAll(
                  resource.data.interactiveData.get('votes', {}).keys()
                );
    }

    match /stories/{storyId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interactiveData'])
        && storyContentUnchanged()
      );
    }

    // STORY RESPONSES
    match /story_responses/{responseId} {
      allow read: if isAuth() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // FEED POSTS
    match /feed_posts/{postId} {
      allow read: if isAuth();
      allow create: if isAdmin() || isTeacher();
      // `likes` — useNewsFeed `arrayUnion/arrayRemove(uid)` yuboradi, ya'ni
      // foydalanuvchi faqat O'Z uid'ini qo'sha/olib tashlay oladi; boshqalarning
      // like'lariga tegib bo'lmaydi (ilgari butun massivni tozalab yuborish
      // mumkin edi). `commentsCount` esa ±1 qadam bilan.
      allow update: if isAdmin() || isTeacher() || (
        isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount'])
        && likesTouchSelfOnly()
        && counterDeltaOk('commentsCount')
      );
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);

      // COMMENTS SUBCOLLECTION
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    // SPEAKING SESSIONS (AI Speaking moduli)
    // Yozuvni faqat server (Admin SDK) qiladi: band ballar, o'qituvchi
    // tekshiruvining holati va to'lov statusi klientdan yozilsa, o'quvchi
    // o'ziga 9.0 qo'yib yoki to'lovni chetlab o'tib ketardi.
    match /speakingSessions/{sessionId} {
      function isOwner() {
        return isAuth() && resource.data.get('uid', '') == request.auth.uid;
      }

      allow read: if isOwner() || isAdmin() || isTeacher();
      allow write: if isAdmin();

      match /answers/{answerId} {
        allow read: if isAuth() && (
          resource.data.get('uid', '') == request.auth.uid || isAdmin() || isTeacher()
        );
        // O'qituvchi o'z tekshiruvini `reviewSpeakingAnswer` callable orqali
        // yozadi — bu yerda emas, toki narx/holat serverda hal bo'lsin.
        allow write: if isAdmin();
      }
    }

    // SPEAKING QUESTIONS (o'qituvchi qo'shgan mavzular)
    // Statik bazadagi savollar kodda; bu yerda faqat o'qituvchi yozganlari.
    match /speakingQuestions/{topicId} {
      allow read: if isAuth();
      allow create: if (isTeacher() || isAdmin())
                    && request.resource.data.get('authorId', '') == request.auth.uid;
      allow update, delete: if isAdmin()
                            || (isTeacher() && resource.data.get('authorId', '') == request.auth.uid);
    }

    // SPEAKING REVIEW ORDERS (pullik jonli tekshiruv buyurtmalari)
    // Narx va holat serverda: `requestSpeakingReview` yaratadi, Telegram
    // botdagi admin tasdig'i to'langan holatga o'tkazadi.
    match /speakingReviewOrders/{orderId} {
      allow read: if isAuth() && (
        resource.data.get('uid', '') == request.auth.uid || isAdmin() || isTeacher()
      );
      allow write: if isAdmin();
    }

    // LOGIN SESSIONS (Telegram orqali parolsiz kirish)
    //
    // ⚠️ Ilgari bu yerda `allow read, delete: if true` turardi. Firestore'da
    // `read` — bu `get` ham, `list` ham, ya'ni istalgan odam tizimga
    // kirmasdan `getDocs(collection(db, "login_sessions"))` deb butun
    // kolleksiyani so'rab, o'sha payt kirayotgan HAR QANDAY foydalanuvchining
    // custom token'ini olib ketardi — to'liq hisob o'g'irlash. `delete: true`
    // esa har kimga barcha loginlarni buzish imkonini berardi.
    //
    // Endi hujjat klientga umuman ko'rinmaydi: tokenni faqat sessiyani
    // boshlagan brauzer, maxfiy `pollKey` ni ko'rsatib, `claimTelegramLogin`
    // callable orqali oladi (functions/telegramLogin.js).
    match /login_sessions/{sessionId} {
      allow read, write: if false; // Faqat Admin SDK
    }

    // DISCOUNT CLAIMS (ro'yxatdan o'tish chegirmasi sarflangani haqidagi reyestr)
    //
    // Chegirma IKKI joyda yashaydi:
    //   • `users/{uid}.signupDiscount` — TAKLIF. Egasi o'qiy oladi (UI uchun),
    //     lekin yoza olmaydi (`protectedUserFields` ro'yxatida).
    //   • `discount_claims/{key}` — SARFLASH reyestri. Kalit `uid` ga emas,
    //     SHAXSGA bog'langan: `tg_{telegramId}` va `ph_{phoneNumber}`.
    //
    // Ikkinchisi aynan shu maqsad uchun kerak: o'quvchi yangi email bilan
    // yangi hisob ochsa `uid` almashadi, lekin to'lov baribir o'sha bitta
    // Telegram akkaunti orqali o'tadi (`handlePaymentStart` da `chatId` bor) —
    // ya'ni 10 ta hisob bitta reyestr yozuviga urilib qaytadi.
    //
    // Klient bu hujjatlarni O'QIY OLMAYDI ham: aks holda kalitlarni sanab
    // chiqib, qaysi telefon raqami chegirmani ishlatganini bilib olish mumkin.
    match /discount_claims/{claimId} {
      allow read, write: if false; // Faqat Admin SDK (telegramBot / Cloud Functions)
    }

    // TRIAL RESULTS (landing page'dagi bepul test natijalari)
    //
    // Guest anonim sessiyada ishlaydi va bu hujjatga umuman tegmaydi:
    // natijani `submitTrial` Admin SDK bilan yozadi va javob sifatida
    // klientga qaytaradi. Klient yozuvga ruxsat olsa, band ballni o'zi
    // qo'yib chegirmani "yutib" olardi.
    match /trial_results/{uid} {
      allow read, write: if false; // Faqat Admin SDK
    }

    // OTHER COLLECTIONS (Generic fallback)
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
